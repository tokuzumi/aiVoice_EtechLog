FROM node:20-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
COPY . .

# Injeta variáveis de ambiente no momento do build
ARG VITE_AGENT_API_URL
ARG VITE_DASHBOARD_API_URL
ARG VITE_INSTANCE_CLIENT_NAME
ARG VITE_IMG_LOGO_MAIN
ARG VITE_IMG_CHAT_HEADER
ARG VITE_CLIENT_TITLE
ARG VITE_CLIENT_DESCRIPTION

ENV VITE_AGENT_API_URL=$VITE_AGENT_API_URL
ENV VITE_DASHBOARD_API_URL=$VITE_DASHBOARD_API_URL
ENV VITE_INSTANCE_CLIENT_NAME=$VITE_INSTANCE_CLIENT_NAME
ENV VITE_IMG_LOGO_MAIN=$VITE_IMG_LOGO_MAIN
ENV VITE_IMG_CHAT_HEADER=$VITE_IMG_CHAT_HEADER
ENV VITE_CLIENT_TITLE=$VITE_CLIENT_TITLE
ENV VITE_CLIENT_DESCRIPTION=$VITE_CLIENT_DESCRIPTION

RUN npm run build

FROM node:20-alpine
WORKDIR /app
RUN npm install -g serve
COPY --from=builder /app/dist ./dist
EXPOSE 5173
CMD ["serve", "-s", "dist", "-l", "5173"]
